{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/",
      "missing": [
        { "type": "host", "value": "amvo.store" },
        { "type": "host", "value": "www.amvo.store" }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/:page(privacy|support|intelligence|changelog|clipboard-history-mac|mac-command-history|comparison|developer-clipboard|custom-actions|jwt-decoder-mac|json-formatter-mac|regex-clipboard-mac)",
      "missing": [
        { "type": "host", "value": "amvo.store" },
        { "type": "host", "value": "www.amvo.store" }
      ],
      "destination": "/en/:page",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "amvo.store" }],
      "destination": "/amvo-store/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.amvo.store" }],
      "destination": "/amvo-store/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/l2cache/$1"
    }
  ]
}
