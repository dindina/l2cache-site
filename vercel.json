{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/",
      "missing": [
        { "type": "host", "value": "amvo.store" },
        { "type": "host", "value": "www.amvo.store" }
      ],
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/tools/:tool*",
      "missing": [
        { "type": "host", "value": "amvo.store" },
        { "type": "host", "value": "www.amvo.store" }
      ],
      "destination": "/en/tools/:tool*",
      "permanent": true
    },
    {
      "source": "/:page(tools|privacy|support|intelligence|changelog|clipboard-history-mac|mac-command-history|comparison|benchmark|developer-clipboard|custom-actions|jwt-decoder-mac|json-formatter-mac|regex-clipboard-mac|screenshot-ocr-mac|sql-test-data-generator|sitemap|blog|blog-[a-zA-Z0-9_-]+|l2cache-vs-[a-zA-Z0-9_-]+)",
      "missing": [
        { "type": "host", "value": "amvo.store" },
        { "type": "host", "value": "www.amvo.store" }
      ],
      "destination": "/en/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "amvo.store" }],
      "destination": "/amvo-store/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.amvo.store" }],
      "destination": "/amvo-store/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/l2cache/$1"
    }
  ]
}
