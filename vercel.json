{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "out",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "missing": [
        {
          "type": "host",
          "value": "amvo.store"
        },
        {
          "type": "host",
          "value": "www.amvo.store"
        },
        {
          "type": "host",
          "value": "hingejoy.amvo.store"
        },
        {
          "type": "host",
          "value": "www.hingejoy.amvo.store"
        }
      ],
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/:lang(zh-Hans|fr|de|it|ja|ko|pt-BR|es|vi)/tools/:tool*",
      "missing": [
        {
          "type": "host",
          "value": "amvo.store"
        },
        {
          "type": "host",
          "value": "www.amvo.store"
        },
        {
          "type": "host",
          "value": "hingejoy.amvo.store"
        },
        {
          "type": "host",
          "value": "www.hingejoy.amvo.store"
        }
      ],
      "destination": "/en/tools/:tool*",
      "permanent": true
    },
    {
      "source": "/:lang(zh-Hans|fr|de|it|ja|ko|pt-BR|es|vi)/:page((?!$)[^/]+)",
      "missing": [
        {
          "type": "host",
          "value": "amvo.store"
        },
        {
          "type": "host",
          "value": "www.amvo.store"
        },
        {
          "type": "host",
          "value": "hingejoy.amvo.store"
        },
        {
          "type": "host",
          "value": "www.hingejoy.amvo.store"
        }
      ],
      "destination": "/en/:page",
      "permanent": true
    },
    {
      "source": "/tools/:tool*",
      "missing": [
        {
          "type": "host",
          "value": "amvo.store"
        },
        {
          "type": "host",
          "value": "www.amvo.store"
        },
        {
          "type": "host",
          "value": "hingejoy.amvo.store"
        },
        {
          "type": "host",
          "value": "www.hingejoy.amvo.store"
        }
      ],
      "destination": "/en/tools/:tool*",
      "permanent": true
    },
    {
      "source": "/:page((?!en|zh-Hans|fr|de|it|ja|ko|pt-BR|es|vi|_vercel|tools|icon\\.png|theme\\.css|screenshots|sitemap\\.xml|robots\\.txt|benchmark_dataset_2026\\.csv|llms\\.txt|llms-full\\.txt|f429f476aace450d98d63642289564df\\.txt|BingSiteAuth\\.xml)[^/]+)",
      "missing": [
        {
          "type": "host",
          "value": "amvo.store"
        },
        {
          "type": "host",
          "value": "www.amvo.store"
        },
        {
          "type": "host",
          "value": "hingejoy.amvo.store"
        },
        {
          "type": "host",
          "value": "www.hingejoy.amvo.store"
        }
      ],
      "destination": "/en/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "hingejoy.amvo.store"
        }
      ],
      "destination": "/hingejoy/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.hingejoy.amvo.store"
        }
      ],
      "destination": "/hingejoy/$1"
    },
    {
      "source": "/hingejoy/(.*)",
      "destination": "/hingejoy/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "amvo.store"
        }
      ],
      "destination": "/amvo-store/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.amvo.store"
        }
      ],
      "destination": "/amvo-store/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/l2cache/$1"
    }
  ]
}